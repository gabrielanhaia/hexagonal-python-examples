# Copy to .env to change how docker compose runs roombook.
# Every variable is optional; the values below are the defaults.

# fake: a pretend Coinwren checkout. coinwren: the real client.
ROOMBOOK_PAYMENTS=fake
ROOMBOOK_COINWREN_URL=https://api.coinwren.example
ROOMBOOK_COINWREN_API_KEY=

# console: notifications go to the log. smtp: one email per event.
ROOMBOOK_NOTIFIER=console
ROOMBOOK_SMTP_HOST=localhost
ROOMBOOK_SMTP_PORT=25

ROOMBOOK_LOG_JSON=false
ROOMBOOK_TRACE_TO_CONSOLE=false
